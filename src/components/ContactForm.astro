---
---

<form
  name="kontakt"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-6"
  aria-label="Kontaktformular"
>
  <input type="hidden" name="form-name" value="kontakt" />
  <p class="hidden">
    <label>Nicht ausfüllen: <input name="bot-field" /></label>
  </p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
        Vollständiger Name <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        placeholder="Max Mustermann"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors"
        aria-required="true"
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
        E-Mail-Adresse <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        placeholder="max@example.at"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors"
        aria-required="true"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
        Telefonnummer
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        placeholder="+43 680 1528027"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors"
      />
    </div>

    <div>
      <label for="wunschtermin" class="block text-sm font-medium text-gray-700 mb-1">
        Wunschtermin
      </label>
      <input
        type="text"
        id="wunschtermin"
        name="wunschtermin"
        placeholder="z.B. Dienstag Vormittag"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors"
      />
    </div>
  </div>

  <div>
    <label for="betreff" class="block text-sm font-medium text-gray-700 mb-1">
      Betreff
    </label>
    <select
      id="betreff"
      name="betreff"
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors bg-white"
    >
      <option value="">Bitte wählen...</option>
      <option value="terminanfrage">Terminanfrage</option>
      <option value="manuelle-therapie">Manuelle Therapie</option>
      <option value="krankengymnastik">Krankengymnastik</option>
      <option value="sportphysio">Sportphysiotherapie</option>
      <option value="massage">Massagetherapie</option>
      <option value="hausbesuch">Hausbesuch</option>
      <option value="sonstiges">Sonstiges</option>
    </select>
  </div>

  <div>
    <label for="nachricht" class="block text-sm font-medium text-gray-700 mb-1">
      Ihre Nachricht <span class="text-red-500" aria-hidden="true">*</span>
    </label>
    <textarea
      id="nachricht"
      name="nachricht"
      required
      rows="5"
      placeholder="Beschreiben Sie Ihr Anliegen kurz..."
      class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-primary focus:border-teal-primary outline-none transition-colors resize-y"
      aria-required="true"
    ></textarea>
  </div>

  <div class="flex items-start space-x-3">
    <input
      type="checkbox"
      id="datenschutz"
      name="datenschutz"
      required
      class="mt-0.5 w-4 h-4 text-teal-primary border-gray-300 rounded focus:ring-teal-primary"
      aria-required="true"
    />
    <label for="datenschutz" class="text-sm text-gray-600">
      Ich habe die <a href="/datenschutz" class="text-teal-primary hover:underline">Datenschutzerklärung</a> gelesen und akzeptiere diese. <span class="text-red-500" aria-hidden="true">*</span>
    </label>
  </div>

  <button
    type="submit"
    class="w-full sm:w-auto px-8 py-3 bg-teal-primary text-white font-semibold rounded-lg hover:bg-teal-light transition-colors duration-200 text-base focus:outline-none focus:ring-2 focus:ring-teal-primary focus:ring-offset-2"
  >
    Nachricht senden
  </button>
</form>
