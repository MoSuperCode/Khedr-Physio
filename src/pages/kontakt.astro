---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const oeffnungszeiten = [
  { tag: 'Montag', zeiten: '08:00 – 18:00' },
  { tag: 'Dienstag', zeiten: '08:00 – 18:00' },
  { tag: 'Mittwoch', zeiten: '08:00 – 18:00' },
  { tag: 'Donnerstag', zeiten: '08:00 – 18:00' },
  { tag: 'Freitag', zeiten: '08:00 – 16:00' },
  { tag: 'Samstag', zeiten: 'Geschlossen' },
  { tag: 'Sonntag', zeiten: 'Geschlossen' },
];

const today = new Date().toLocaleDateString('de-AT', { weekday: 'long' });
---

<BaseLayout
  title="Kontakt | Khedr Physiotherapie"
  description="Kontaktieren Sie die Khedr Physiotherapie in Klagenfurt. Termin vereinbaren, Öffnungszeiten, Adresse und Anfahrt. Wir freuen uns auf Ihren Anruf oder Ihre Nachricht."
  breadcrumb={[{ name: 'Kontakt', url: '/kontakt' }]}
>
  <Header />

  <main id="main-content">
    <!-- Page Hero -->
    <div class="bg-teal-dark py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="flex items-center space-x-2 text-sm text-teal-200">
            <li><a href="/" class="hover:text-white transition-colors">Startseite</a></li>
            <li aria-hidden="true"><span class="mx-1">/</span></li>
            <li class="text-white font-medium" aria-current="page">Kontakt</li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Kontakt & Termin</h1>
        <p class="text-teal-100 text-lg max-w-2xl">Nehmen Sie Kontakt auf – wir melden uns schnellstmöglich zurück.</p>
      </div>
    </div>

    <!-- Main Contact Section -->
    <section class="py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- Contact Info -->
          <aside class="lg:col-span-1 space-y-6" aria-label="Kontaktinformationen">

            <!-- Adresse -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <h2 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Adresse
              </h2>
              <address class="not-italic text-sm text-gray-600 leading-relaxed">
                <strong class="text-gray-900">Khedr Physiotherapie</strong><br/>
                [Adresse eintragen]<br/>
                9020 Klagenfurt<br/>
                Österreich
              </address>
            </div>

            <!-- Telefon & E-Mail -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <h2 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                Erreichbarkeit
              </h2>
              <div class="space-y-3 text-sm">
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Telefon</p>
                  <a href="tel:+43 680 1528027" class="text-teal-primary font-semibold hover:underline">+43 680 1528027</a>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">E-Mail</p>
                  <a href="mailto:info@khedr-physiotherapie.at" class="text-teal-primary font-semibold hover:underline break-all">info@khedr-physiotherapie.at</a>
                </div>
              </div>
            </div>

            <!-- Öffnungszeiten -->
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6">
              <h2 class="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Öffnungszeiten
              </h2>
              <table class="w-full text-sm" aria-label="Öffnungszeiten der Physiotherapiepraxis">
                <tbody>
                  {oeffnungszeiten.map(o => (
                    <tr class={`${o.tag === today ? 'font-semibold text-teal-primary' : 'text-gray-600'}`}>
                      <td class="py-1">{o.tag}</td>
                      <td class="py-1 text-right">{o.zeiten}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="mt-3 text-xs text-gray-500">Termine nach Vereinbarung auch außerhalb der Öffnungszeiten möglich.</p>
            </div>

            <!-- Notfall -->
            <div class="bg-red-50 rounded-xl border border-red-100 p-5">
              <h2 class="font-bold text-red-800 text-sm mb-2 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Notfall & Dringend
              </h2>
              <p class="text-red-700 text-xs leading-relaxed">
                Bei akuten Notfällen wenden Sie sich bitte an den Notruf <strong>144</strong> oder Ihren Hausarzt. Für dringende physiotherapeutische Anfragen rufen Sie uns direkt an.
              </p>
            </div>
          </aside>

          <!-- Contact Form -->
          <div class="lg:col-span-2">
            <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 md:p-8">
              <h2 class="font-bold text-gray-900 text-xl mb-2">Schreiben Sie uns</h2>
              <p class="text-gray-600 text-sm mb-6">Wir antworten in der Regel innerhalb von 24 Stunden (werktags).</p>
              <ContactForm />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Google Maps Placeholder -->
    <section class="pb-16 md:pb-20" aria-labelledby="karte-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="karte-heading" class="text-xl font-bold text-gray-900 mb-4">Anfahrt</h2>
        <div
          class="w-full aspect-[16/6] rounded-xl overflow-hidden border border-gray-200 bg-sage-light flex items-center justify-center"
          role="region"
          aria-label="Kartenansicht – Google Maps Platzhalter"
        >
          <!-- PLACEHOLDER: Replace this div with actual Google Maps embed iframe -->
          <!-- Example:
          <iframe
            src="https://www.google.com/maps/embed?pb=9020"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Standort Khedr Physiotherapie"
          ></iframe>
          -->
          <div class="text-center text-teal-primary p-8">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            <p class="text-sm font-medium opacity-60">Google Maps Einbettung hier einfügen</p>
            <p class="text-xs opacity-40 mt-1">[Adresse eintragen], 9020 Klagenfurt</p>
          </div>
        </div>
        <div class="mt-4 flex flex-col sm:flex-row gap-3">
          <a
            href="https://maps.google.com/?q=Musterstraße+1+Klagenfurt"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-teal-primary text-white text-sm font-semibold rounded-lg hover:bg-teal-light transition-colors"
            aria-label="Route in Google Maps öffnen (öffnet in neuem Tab)"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            In Google Maps öffnen
          </a>
          <p class="text-sm text-gray-600 self-center">
            <strong>ÖPNV:</strong> Linie X, Haltestelle Musterplatz (2 Min. Fußweg)
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
