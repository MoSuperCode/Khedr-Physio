---
import { withBase } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const teamMembers = [
  {
    name: 'Karim Khedr',
    title: 'Diplomierter Physiotherapeut',
    specialization: 'Manuelle Therapie, Sportphysiotherapie, Krankengymnastik',
    bio: 'Karim Khedr ist Inhaber und Therapeut der Khedr Physiotherapie in Klagenfurt. Mit fundierter Ausbildung und langjähriger Erfahrung behandelt er seine Patienten individuell und ganzheitlich – vom Sportler bis zum Reha-Patienten.',
  },
];

const versicherungen = [
  'Österreichische Gesundheitskasse (ÖGK)',
  'Sozialversicherungsanstalt der Selbständigen (SVS)',
  'Versicherungsanstalt öffentlich Bediensteter (BVA)',
  'Kriegsopferversorgung (KFV)',
];
---

<BaseLayout
  title="Über uns | Khedr Physiotherapie"
  description="Lernen Sie unser Team kennen. Erfahrene Physiotherapeuten in Klagenfurt mit Kassenverträgen und modernster Ausstattung. Ihre Gesundheit ist unser Auftrag."
  breadcrumb={[{ name: 'Über uns', url: '/ueber-uns' }]}
>
  <Header />

  <main id="main-content">
    <!-- Page Hero -->
    <div class="bg-teal-dark py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="flex items-center space-x-2 text-sm text-teal-200">
            <li><a href={withBase("/")} class="hover:text-white transition-colors">Startseite</a></li>
            <li aria-hidden="true"><span class="mx-1">/</span></li>
            <li class="text-white font-medium" aria-current="page">Über uns</li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Über unsere Praxis</h1>
        <p class="text-teal-100 text-lg max-w-2xl">Erfahren Sie mehr über unsere Geschichte, unser Team und unsere Philosophie.</p>
      </div>
    </div>

    <!-- Geschichte -->
    <section class="py-16 md:py-20" aria-labelledby="geschichte-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Unsere Geschichte</span>
            <h2 id="geschichte-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900 mb-4">
              Khedr Physiotherapie Klagenfurt – für Ihre Gesundheit
            </h2>
            <p class="text-gray-600 leading-relaxed mb-4">
              Die Khedr Physiotherapie wurde im Jahr [Gründungsjahr eintragen] von Karim Khedr gegründet. Mit dem Ziel, Patienten in Klagenfurt und Umgebung eine qualitativ hochwertige und individuelle Physiotherapie anzubieten, öffneten wir unsere Praxis im Herzen der Stadt.
            </p>
            <p class="text-gray-600 leading-relaxed mb-4">
              Was als Einzelpraxis begann, wuchs über die Jahre zu einem kleinen, aber feinen Team, das Ihnen heute ein breites Spektrum an physiotherapeutischen Leistungen anbietet.
            </p>
            <p class="text-gray-600 leading-relaxed">
              Unser Anspruch war und ist es, jeden Patienten als Individuum zu behandeln und maßgeschneiderte Therapiepläne zu entwickeln, die nachhaltig wirken.
            </p>
          </div>
          <div
            class="aspect-[4/3] rounded-2xl bg-sage-light flex items-center justify-center border-2 border-dashed border-sage-DEFAULT"
            role="img"
            aria-label="Praxisfoto – Platzhalter für echtes Foto"
          >
            <div class="text-center text-teal-primary p-6">
              <svg class="w-16 h-16 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <p class="text-sm font-medium opacity-60">Praxisfoto hier einfügen</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="py-16 md:py-20 bg-warm" aria-labelledby="team-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Unser Team</span>
          <h2 id="team-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
            Ihre Therapeuten
          </h2>
          <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
            Unser Team besteht aus diplomierten Physiotherapeuten mit langjähriger Erfahrung und spezialisierten Zusatzqualifikationen.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {teamMembers.map(member => (
            <article class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex gap-6">
              <div
                class="w-20 h-20 rounded-full bg-sage-light flex items-center justify-center flex-shrink-0 border-2 border-dashed border-sage-DEFAULT"
                role="img"
                aria-label={`Foto von ${member.name} – Platzhalter`}
              >
                <svg class="w-8 h-8 text-teal-primary opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-lg">{member.name}</h3>
                <p class="text-teal-primary text-sm font-medium mb-1">{member.title}</p>
                <p class="text-xs text-gray-500 mb-3">Schwerpunkt: {member.specialization}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{member.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Philosophie -->
    <section class="py-16 md:py-20 bg-sage-light" aria-labelledby="philosophie-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Unsere Philosophie</span>
          <h2 id="philosophie-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900 mb-6">
            Ganzheitlich. Individuell. Nachhaltig.
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            Wir glauben daran, dass jeder Mensch das Recht auf ein Leben ohne Schmerzen und mit größtmöglicher Bewegungsfreiheit hat. Deshalb behandeln wir nicht nur Symptome, sondern suchen nach den Ursachen Ihrer Beschwerden.
          </p>
          <p class="text-gray-600 leading-relaxed mb-8">
            In enger Zusammenarbeit mit Ärzten und anderen Gesundheitsberufen bieten wir Ihnen eine umfassende Betreuung, die über die Praxis hinausgeht – mit individuellen Heimübungen und langfristiger Prävention.
          </p>
          <div class="grid grid-cols-3 gap-6">
            <div class="text-center">
              <div class="text-3xl font-bold text-teal-primary mb-1">10+</div>
              <div class="text-sm text-gray-600">Jahre Erfahrung</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-teal-primary mb-1">500+</div>
              <div class="text-sm text-gray-600">Zufriedene Patienten</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-bold text-teal-primary mb-1">4</div>
              <div class="text-sm text-gray-600">Kassenverträge</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ausstattung -->
    <section class="py-16 md:py-20" aria-labelledby="ausstattung-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Praxis-Ausstattung</span>
          <h2 id="ausstattung-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
            Modernste Behandlungsräume
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            { name: 'Behandlungsräume', desc: '3 modern ausgestattete, helle Behandlungsräume mit höhenverstellbaren Therapieliegen' },
            { name: 'Trainingsbereich', desc: 'Therapeutisches Training mit Seilzug, Freihanteln und Therapiebändern' },
            { name: 'Elektrotherapie-Geräte', desc: 'TENS, Ultraschall, Magnetfeldtherapie und Lasertherapie der neuesten Generation' },
            { name: 'Wartebereich', desc: 'Einladender Wartebereich mit kostenlosem WLAN und Getränken für unsere Patienten' },
            { name: 'Barrierefreiheit', desc: 'Vollständig barrierefrei zugänglich mit Lift und behindertengerechten Einrichtungen' },
            { name: 'Parkplätze', desc: 'Ausreichend Parkplätze direkt vor der Praxis für unsere Patienten vorhanden' },
          ].map(item => (
            <div class="flex items-start space-x-3 p-4 rounded-lg bg-white border border-gray-100 shadow-sm">
              <div class="w-8 h-8 rounded-md bg-teal-primary flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900 text-sm">{item.name}</h3>
                <p class="text-gray-600 text-xs mt-0.5 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Kassenverträge -->
    <section class="py-16 md:py-20 bg-warm" aria-labelledby="kassen-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-8">
            <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Kassenverträge</span>
            <h2 id="kassen-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
              Verträge mit allen wichtigen Krankenkassen
            </h2>
            <p class="mt-3 text-gray-600">
              Wir haben Verträge mit folgenden Krankenkassen. Bringen Sie Ihre Verordnung vom Arzt mit.
            </p>
          </div>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
            {versicherungen.map(v => (
              <li class="flex items-center space-x-3 p-4 bg-white rounded-lg border border-gray-100 shadow-sm">
                <div class="w-6 h-6 rounded-full bg-sage-light flex items-center justify-center flex-shrink-0" aria-hidden="true">
                  <svg class="w-3 h-3 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-sm text-gray-700">{v}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-gray-500 text-center">
            Privatzahler und andere Versicherungen sind selbstverständlich ebenfalls willkommen. <a href={withBase("/kontakt")} class="text-teal-primary hover:underline">Kontaktieren Sie uns</a> für weitere Informationen.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
