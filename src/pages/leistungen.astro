---
import { withBase } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const leistungen = [
  {
    title: 'Manuelle Therapie',
    icon: '🤲',
    beschreibung: 'Die Manuelle Therapie ist eine spezialisierte Form der Physiotherapie, bei der durch gezielte Handgriffe Funktionsstörungen an Gelenken, Muskeln und Bindegewebe behandelt werden. Sie eignet sich besonders bei Beschwerden der Wirbelsäule, Schulter, Hüfte, Knie und anderen Gelenken.',
    indikationen: ['Rückenschmerzen', 'Nackenschmerzen', 'Schulter-Arm-Syndrom', 'Kopfschmerzen (Cervicogen)', 'Gelenkblockierungen'],
    kasse: true,
  },
  {
    title: 'Krankengymnastik',
    icon: '🏃',
    beschreibung: 'Aktive und passive Übungstherapie zur Wiederherstellung und Verbesserung von Beweglichkeit, Kraft und Koordination. Individuell auf Ihre Bedürfnisse angepasst – ob nach einer Operation, bei chronischen Erkrankungen oder zur Vorbeugung.',
    indikationen: ['Postoperative Rehabilitation', 'Orthopädische Erkrankungen', 'Neurologische Erkrankungen', 'Chronische Schmerzsyndrome'],
    kasse: true,
  },
  {
    title: 'Sportphysiotherapie',
    icon: '⚡',
    beschreibung: 'Speziell auf Sportler ausgerichtete Behandlung: schnelle und sichere Rückkehr in den Sport nach Verletzungen, Leistungsoptimierung und Verletzungsprävention. Wir kennen die Anforderungen des Sports und behandeln Sie entsprechend.',
    indikationen: ['Sportverletzungen', 'Muskelfaserrisse', 'Bänderdehnungen und -risse', 'Überlastungsschäden', 'Sporttaping'],
    kasse: false,
  },
  {
    title: 'Massagetherapie',
    icon: '💆',
    beschreibung: 'Von der klassischen Massage bis zur Bindegewebsmassage und Lymphdrainage. Massagen fördern die Durchblutung, lockern Verspannungen und unterstützen die Regeneration.',
    indikationen: ['Muskelverspannungen', 'Stressbedingte Beschwerden', 'Lymphödem', 'Narbenbehandlung', 'Allgemeine Entspannung'],
    kasse: true,
  },
  {
    title: 'Elektrotherapie',
    icon: '⚙️',
    beschreibung: 'Einsatz elektrischer Reize zur Schmerztherapie, Muskelstimulation und Förderung der Geweberegeneration. Modernste Geräte für TENS, Ultraschall, Magnetfeldtherapie und Lasertherapie.',
    indikationen: ['Akute und chronische Schmerzen', 'Entzündliche Prozesse', 'Muskelatrophie', 'Wundheilung', 'Arthrose'],
    kasse: true,
  },
  {
    title: 'Hausbesuche',
    icon: '🏠',
    beschreibung: 'Für Patienten mit eingeschränkter Mobilität oder auf ärztliche Verordnung kommen wir zu Ihnen nach Hause. Professionelle Physiotherapie im vertrauten Umfeld – ganz ohne Fahrtstress.',
    indikationen: ['Pflegebedürftige Patienten', 'Post-stationäre Behandlung', 'Neurologische Erkrankungen', 'Eingeschränkte Mobilität'],
    kasse: true,
  },
];

const preise = [
  { leistung: 'Erstbefund (60 Min.)', preis: '€ 90,–', hinweis: 'Incl. Behandlungsplanung' },
  { leistung: 'Physiotherapie-Einzelstunde (50 Min.)', preis: '€ 75,–', hinweis: 'Privatleistung' },
  { leistung: 'Physiotherapie-Kurzstunde (30 Min.)', preis: '€ 50,–', hinweis: 'Privatleistung' },
  { leistung: 'Massage (30 Min.)', preis: '€ 55,–', hinweis: 'Privatleistung' },
  { leistung: 'Massage (60 Min.)', preis: '€ 85,–', hinweis: 'Privatleistung' },
  { leistung: 'Elektrotherapie (20 Min.)', preis: '€ 35,–', hinweis: 'Privatleistung' },
  { leistung: 'Hausbesuch (zzgl. Wegpauschale)', preis: 'auf Anfrage', hinweis: 'Je nach Distanz' },
  { leistung: 'Kassenleistung (mit Verordnung)', preis: 'nach Tarif', hinweis: 'Zuzahlung je nach Kasse' },
];

const faqs = [
  {
    frage: 'Benötige ich eine ärztliche Überweisung?',
    antwort: 'Für Kassenleistungen benötigen Sie eine Verordnung von Ihrem Arzt. Privatpatienten können sich auch ohne Überweisung direkt an uns wenden. Kontaktieren Sie uns bei Fragen.',
  },
  {
    frage: 'Wie lange dauert eine Behandlungseinheit?',
    antwort: 'Eine Standardbehandlung dauert in der Regel 50 Minuten. Bei manchen Kassentarifen sind auch kürzere Einheiten (z.B. 30 Minuten) vorgesehen. Die erste Einheit inkl. Befundaufnahme dauert ca. 60–75 Minuten.',
  },
  {
    frage: 'Wie viele Behandlungen benötige ich?',
    antwort: 'Das hängt stark von Ihrer Diagnose und Ihrem Behandlungsziel ab. Kassenverordnungen umfassen meist 6–10 Einheiten. Beim Erstgespräch besprechen wir, was für Sie sinnvoll ist.',
  },
  {
    frage: 'Was soll ich zur Behandlung mitbringen?',
    antwort: 'Bringen Sie bitte Ihre ärztliche Verordnung (falls vorhanden), Ihre E-Card, bequeme Kleidung und relevante Arztbriefe oder Befunde mit. Bei Rückenbehandlungen empfehlen sich kurze Hosen oder sportliche Leggings.',
  },
  {
    frage: 'Gibt es Parkplätze bei der Praxis?',
    antwort: 'Ja, direkt vor der Praxis stehen Parkplätze für unsere Patienten zur Verfügung. Die Praxis ist auch mit öffentlichen Verkehrsmitteln gut erreichbar.',
  },
  {
    frage: 'Wie storniere ich einen Termin?',
    antwort: 'Bitte sagen Sie Termine mindestens 24 Stunden im Voraus ab. Kurzfristige Absagen (unter 24 Stunden) können wir leider in Rechnung stellen, da der Termin für andere Patienten nicht mehr verfügbar gemacht werden kann.',
  },
];
---

<BaseLayout
  title="Leistungen & Preise | Khedr Physiotherapie"
  description="Alle physiotherapeutischen Leistungen auf einen Blick: Manuelle Therapie, Krankengymnastik, Massage, Elektrotherapie und mehr. Transparente Preise und Kassenabrechnungen."
  breadcrumb={[{ name: 'Leistungen & Preise', url: '/leistungen' }]}
>
  <Header />

  <main id="main-content">
    <!-- Page Hero -->
    <div class="bg-teal-dark py-16 md:py-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="flex items-center space-x-2 text-sm text-teal-200">
            <li><a href={withBase("/")} class="hover:text-white transition-colors">Startseite</a></li>
            <li aria-hidden="true"><span class="mx-1">/</span></li>
            <li class="text-white font-medium" aria-current="page">Leistungen & Preise</li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Leistungen & Preise</h1>
        <p class="text-teal-100 text-lg max-w-2xl">Umfassende Physiotherapie mit transparenten Preisen. Kassenabrechnung möglich.</p>
      </div>
    </div>

    <!-- Kasse vs. Privat -->
    <section class="py-12 bg-sage-light" aria-labelledby="abrechnung-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 id="abrechnung-heading" class="sr-only">Kassenleistungen und Privatleistungen</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-xl p-6 border-l-4 border-teal-primary shadow-sm">
            <h3 class="font-bold text-gray-900 text-lg mb-2">Kassenleistungen</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Mit einer ärztlichen Verordnung können viele Leistungen über Ihre Krankenkasse abgerechnet werden. Sie zahlen nur die eventuelle Rezeptgebühr. Wir haben Verträge mit ÖGK, SVS, BVA und KFV.
            </p>
          </div>
          <div class="bg-white rounded-xl p-6 border-l-4 border-sage-DEFAULT shadow-sm">
            <h3 class="font-bold text-gray-900 text-lg mb-2">Privatleistungen</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Ohne Verordnung oder für Leistungen außerhalb des Kassenkatalogs bieten wir Selbstzahlertarife an. Viele Zusatzversicherungen erstatten diese Kosten teilweise oder ganz.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Leistungen Detail -->
    <section class="py-16 md:py-20" aria-labelledby="leistungen-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Unser Angebot</span>
          <h2 id="leistungen-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
            Alle unsere Leistungen
          </h2>
        </div>

        <div class="space-y-6">
          {leistungen.map(l => (
            <article class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <div class="p-6 md:p-8">
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl" aria-hidden="true">{l.icon}</span>
                    <h3 class="font-bold text-gray-900 text-xl">{l.title}</h3>
                  </div>
                  {l.kasse && (
                    <span class="flex-shrink-0 px-2 py-1 bg-teal-primary text-white text-xs font-semibold rounded-md">
                      Kassenleistung möglich
                    </span>
                  )}
                </div>
                <p class="text-gray-600 leading-relaxed mb-4">{l.beschreibung}</p>
                <div>
                  <p class="text-sm font-semibold text-gray-700 mb-2">Typische Indikationen:</p>
                  <ul class="flex flex-wrap gap-2" role="list">
                    {l.indikationen.map(ind => (
                      <li class="px-3 py-1 bg-sage-light text-teal-primary text-xs font-medium rounded-full">
                        {ind}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Preistabelle -->
    <section class="py-16 md:py-20 bg-warm" aria-labelledby="preise-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">Transparenz</span>
          <h2 id="preise-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
            Unsere Preise
          </h2>
          <p class="mt-3 text-gray-600">Alle Preise verstehen sich als Richtwerte. Kassenleistungen werden nach den gültigen Tarifen abgerechnet.</p>
        </div>

        <div class="max-w-3xl mx-auto">
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="w-full text-sm" aria-label="Preistabelle für physiotherapeutische Leistungen">
              <thead>
                <tr class="bg-teal-primary text-white">
                  <th class="text-left px-6 py-4 font-semibold">Leistung</th>
                  <th class="text-right px-6 py-4 font-semibold">Preis</th>
                  <th class="text-right px-6 py-4 font-semibold hidden sm:table-cell">Hinweis</th>
                </tr>
              </thead>
              <tbody>
                {preise.map((p, i) => (
                  <tr class={i % 2 === 0 ? 'bg-white' : 'bg-warm'}>
                    <td class="px-6 py-3 text-gray-700">{p.leistung}</td>
                    <td class="px-6 py-3 text-right font-semibold text-teal-primary">{p.preis}</td>
                    <td class="px-6 py-3 text-right text-gray-500 text-xs hidden sm:table-cell">{p.hinweis}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-gray-500 text-center">
            Alle Preise inkl. MwSt. Änderungen vorbehalten. Bei Fragen kontaktieren Sie uns bitte.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Accordion (pure CSS) -->
    <section class="py-16 md:py-20" aria-labelledby="faq-heading">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-sm font-semibold text-teal-primary uppercase tracking-wider">FAQ</span>
          <h2 id="faq-heading" class="mt-2 text-2xl md:text-3xl font-bold text-gray-900">
            Häufig gestellte Fragen
          </h2>
        </div>

        <div class="space-y-3">
          {faqs.map((faq, i) => (
            <div class="border border-gray-200 rounded-xl overflow-hidden">
              <input
                type="checkbox"
                id={`faq-${i}`}
                class="sr-only peer"
                aria-controls={`faq-answer-${i}`}
              />
              <label
                for={`faq-${i}`}
                class="flex items-center justify-between w-full px-5 py-4 cursor-pointer bg-white hover:bg-warm transition-colors peer-checked:bg-sage-light"
                aria-expanded="false"
              >
                <span class="font-medium text-gray-900 text-sm pr-4">{faq.frage}</span>
                <svg
                  class="w-5 h-5 text-teal-primary flex-shrink-0 transition-transform duration-200 peer-checked:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </label>
              <div
                id={`faq-answer-${i}`}
                class="max-h-0 overflow-hidden transition-all duration-300 peer-checked:max-h-96"
              >
                <p class="px-5 py-4 text-gray-600 text-sm leading-relaxed bg-white border-t border-gray-100">
                  {faq.antwort}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-14 bg-teal-primary">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold text-white mb-4">Bereit für Ihre Behandlung?</h2>
        <p class="text-teal-100 mb-6">Vereinbaren Sie jetzt Ihren ersten Termin – wir freuen uns auf Sie.</p>
        <a href={withBase("/kontakt")} class="inline-block px-8 py-3 bg-white text-teal-primary font-semibold rounded-lg hover:bg-sage-light transition-colors">
          Termin vereinbaren
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* FAQ accordion: label sibling styling not possible with Tailwind peer across siblings */
  /* The peer-checked trick works because label comes before the div in DOM */
  label:has(+ div) svg {
    transition: transform 0.2s;
  }
  input[type="checkbox"]:checked + label svg {
    transform: rotate(180deg);
  }
  input[type="checkbox"]:checked ~ div,
  input[type="checkbox"]:checked + label + div {
    max-height: 24rem;
  }
</style>
